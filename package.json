{
  "name": "m-music",
  "version": "1.0.0",
  "description": "M-Music Web App — frontend for M-Music-Cloud-Server",
  "license": "LOM",
  "author": "MuMung",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "format": "prettier --write \"client/**/*.{ts,tsx,css,json}\" \"shared/**/*.ts\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"client/**/*.{ts,tsx,css,json}\" \"shared/**/*.ts\" \"*.json\" \"*.mjs\""
  },
  "dependencies": {
    "axios": "^1.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "swr": "^2.3.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
