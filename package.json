{
  "name": "m-music",
  "version": "1.0.0",
  "description": "M-Music Project rebuilt with TypeScript, React, and a modular Express API",
  "license": "LOM",
  "author": "MuMung",
  "type": "module",
  "main": "dist/server/server/src/server.js",
  "scripts": {
    "dev": "concurrently \"bun:dev:server\" \"bun:dev:client\"",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:client": "vite --configLoader runner",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build --configLoader runner",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "bun run typecheck:client && bun run typecheck:server",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "make-admin": "tsx scripts/make-admin.ts",
    "start": "node dist/server/server/src/server.js",
    "format": "prettier --write \"client/**/*.{ts,tsx,css,json}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"client/**/*.{ts,tsx,css,json}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"*.json\" \"*.mjs\""
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.66.0",
    "bcrypt": "^6.0.0",
    "concurrently": "^9.2.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.0.0",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "swr": "^2.3.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
