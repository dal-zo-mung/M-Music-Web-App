# ── Required Environment Variables ────────────────────────────
MONGODB_URL=mongodb://localhost:27017/LyricContainer
SESSION_SECRET=your-secure-random-session-secret-key-here

# ── Server configuration ───────────────────────────────────────
PORT=8888
NODE_ENV=development

# ── CORS Origins ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# ── Google OAuth Credentials (Optional) ───────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8888/auth/google/callback

# ── AI Support Chat Configuration (Optional) ──────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Rate Limits (Optional - defaults will apply if unset) ─────
# AUTH_RATE_LIMIT_WINDOW_MS=300000
# AUTH_RATE_LIMIT_MAX=5
# READ_RATE_LIMIT_MAX=240
# READ_RATE_LIMIT_WINDOW_MS=900000
# WRITE_RATE_LIMIT_MAX=80
# WRITE_RATE_LIMIT_WINDOW_MS=900000
# SUBMISSION_RATE_LIMIT_MAX=6
# SUBMISSION_RATE_LIMIT_WINDOW_MS=3600000
# COMMENT_RATE_LIMIT_MAX=20
# COMMENT_RATE_LIMIT_WINDOW_MS=900000
# SUPPORT_CHAT_RATE_LIMIT_MAX=20
# SUPPORT_CHAT_RATE_LIMIT_WINDOW_MS=900000
