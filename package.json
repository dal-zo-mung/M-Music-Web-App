{
  "name": "m-music",
  "version": "1.0.0",
  "description": "M-Music Web App — frontend for M-Music-Cloud-Server",
  "license": "LOM",
  "author": "MuMung",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "bun run typecheck && vite build --configLoader runner",
    "test": "bun test ./tests",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@m-music/chord-core": "file:vendor/m-music-chord-core-0.1.2.tgz",
    "axios": "^1.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "swr": "^2.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
